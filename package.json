{
  "name": "EnglishDictionary",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "seed:words": "node --env-file=.env scripts/seed-words.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json}\"",
    "e2e:ios": "maestro test --exclude-tags offline -e APP_ID=org.reactjs.native.example.EnglishDictionary .maestro",
    "e2e:android": "maestro test --exclude-tags offline -e APP_ID=com.englishdictionary .maestro",
    "e2e:android:offline": "maestro test --include-tags offline -e APP_ID=com.englishdictionary .maestro"
  },
  "dependencies": {
    "@mhpdev/react-native-speech": "^1.4.4",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/material-top-tabs": "^7.8.1",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@shopify/flash-list": "^2.3.3",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/query-async-storage-persister": "^5.105.2",
    "@tanstack/react-query": "^5.105.2",
    "@tanstack/react-query-persist-client": "^5.105.2",
    "axios": "^1.21.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-pager-view": "^9.0.11",
    "react-native-safe-area-context": "^5.11.0",
    "react-native-screens": "^4.30.1",
    "react-native-sound": "^0.13.0",
    "react-native-tab-view": "^4.3.4",
    "react-native-url-polyfill": "^4.0.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@babel/plugin-transform-export-namespace-from": "^7.29.7",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-transform-typescript-metadata": "^0.4.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-native-dotenv": "^5.0.0",
    "test-renderer": "^1.3.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "packageManager": "yarn@4.18.1"
}
